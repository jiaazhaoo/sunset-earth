{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunset-earth",
  "main": "worker.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Created with: npx wrangler d1 create sunset-earth
  // The binding MUST stay "DB" — lib/db.ts reads env.DB. If `wrangler d1 create`
  // offers to add a binding for you, decline it or delete the entry it appends,
  // since it names the binding after the database instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunset-earth",
      "database_id": "d270a188-ef17-4392-991e-b78d567b55f3"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Heavy cron routes iterate every camera; raise the CPU ceiling to match the
  // former Vercel maxDuration=300. Requires a paid Workers plan (free is capped).
  "limits": {
    "cpu_ms": 300000
  },
  // Cloudflare Cron Triggers. The schedules must exactly match the keys in
  // worker.ts CRON_ROUTES so the scheduled() handler can dispatch them.
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 */3 * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    // Non-secret defaults. Set SITE_URL to the deployed URL after the first
    // deploy. CRON_SECRET is a secret: `wrangler secret put CRON_SECRET`.
    "SITE_URL": "https://sunset-earth.workers.dev"
  }
}
