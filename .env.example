# ---- Cron / internal task auth (required in production) ----
# Bearer token that protects /api/compute-rankings, /api/weather-cache,
# /api/replace-link, /api/refresh-links. The Cloudflare scheduled() handler
# sends this token when firing the cron routes.
# In production set it with: npx wrangler secret put CRON_SECRET
CRON_SECRET=generate-a-long-random-string

# Public base URL of the deployment, e.g. https://sunset-earth.<subdomain>.workers.dev
# Used for internal route-to-route calls (replace-link -> weather-cache, etc.)
# and by the Cloudflare scheduled() handler to build cron request URLs.
SITE_URL=https://your-app.workers.dev

# ---- Database ----
# There is no database URL: storage is the Cloudflare D1 binding `DB`,
# declared in wrangler.jsonc. See d1/README.md for setup and data import.
